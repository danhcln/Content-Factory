# AI Content Factory Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Research Defaults
DEFAULT_PRODUCTS_COUNT=10
DEFAULT_KEYWORDS_COUNT=3
DEFAULT_VIDEOS_COUNT=5

# TTS Configuration
TTS_ENGINE=VieNeu-TTS
DEFAULT_VOICE=vi-VN-Standard-A
AUTO_GENERATE_VOICE=true

# Storage Folders
ORIGINAL_FOLDER=downloads/original
PACKAGE_FOLDER=downloads/packages
FINAL_FOLDER=downloads/final

# Server
HOST=127.0.0.1
PORT=8000

# FFmpeg Configuration (Path to local ffmpeg.exe & ffprobe.exe)
FFMPEG_PATH=
FFPROBE_PATH=

# Auto Editor Defaults
AUTO_EDIT_COVER_TYPE=
AUTO_EDIT_BLUR_STRENGTH=
AUTO_EDIT_SOURCE_AUDIO=
AUTO_EDIT_SUBTITLES=
AUTO_EDIT_HOOK=
AUTO_EDIT_AUTO_RENDER=
